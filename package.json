{
  "name": "git-manager-lite",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": "./bin/gml.exe",
  "version": "0.2.14",
  "engines": {
    "bun": "^1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "@types/prompts": "^2.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "prebuild": "bun install",
    "bump": "bun pm version patch",
    "build:exe": "bun run build && bun run bump && bun build ./index.ts --target bun --outfile ./bin/gml.exe --compile --minify --sourcemap --bytecode",
    "build": "bun build ./index.ts --target bun --outfile ./bin/gml.js",
    "run": "bun run index.ts",
    "check-types": "tsc --noEmit",
    "lint": "bun run check-types && bun run biome check"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-progress": "^3.12.0",
    "prompts": "^2.4.2"
  }
}
