{
  "name": "git-manager-lite",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": "./bin/gml.exe",
  "version": "0.2.24",
  "engines": {
    "bun": "^1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@tailwindcss/cli": "^4.3.2",
    "@types/bun": "latest",
    "@types/cli-progress": "^3.11.6",
    "@types/prompts": "^2.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "prebuild": "bun install",
    "bump": "bun pm version patch",
    "build:ui": "bunx tailwindcss -i ./ui/src/globals.css -o ./ui/src/globals.compiled.css --minify && bun build ./ui/index.html --outdir ./ui/dist --target browser --minify",
    "build": "bun build ./index.ts --target bun --outfile ./bin/gml.js",
    "build:exe": "bun run build && bun run bump && bun build ./index.ts --target bun --outfile ./bin/gml.exe --compile --minify --sourcemap --bytecode",
    "serve": "bun run index.ts serve",
    "run": "bun run index.ts",
    "check-types": "tsc --noEmit",
    "lint": "bun run check-types && bun run biome check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cli-progress": "^3.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "prompts": "^2.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  }
}
